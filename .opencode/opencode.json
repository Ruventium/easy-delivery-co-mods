{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "tail_turns": 12
  },
  "tool_output": {
    "max_lines": 150,
    "max_bytes": 6144
  },
  "experimental": {
    "primary_tools": ["edit"]
  },
  "formatter": false,
  "lsp": false,
  "snapshot": true,
  "autoupdate": "notify",
  "share": "manual",
  "logLevel": "WARN"
}
